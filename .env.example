# Copy to .env and fill in real values. Never commit .env.

PORT=8080

# URL of the main Salesworflow web app this relay forwards WhatsApp webhooks to.
WEBAPP_URL=https://example-web-app.azurewebsites.net

# Meta WhatsApp Cloud API credentials for this relay's own number.
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=some-shared-verify-token

# Required as of Phase 0 Session 5 — HMAC signing secret used to verify
# X-Hub-Signature-256 on inbound POST webhooks before they are relayed.
# Must match the main app's FACEBOOK_APP_SECRET (same Meta app). This is a
# distinct value from WHATSAPP_VERIFY_TOKEN above, which only gates the GET
# subscription challenge, not POST authenticity. Without this set, every
# genuine webhook POST will be rejected (fails closed).
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
